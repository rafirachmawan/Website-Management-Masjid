// Skema database lokal (SQLite) — single-file, tanpa server.
// Dijaga via migration: `npm run db:migrate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Profil masjid — satu baris (id = "main"). Template multi-masjid:
// satu database = satu masjid.
model MosqueProfile {
  id              String  @id @default("main")
  name            String
  shortName       String
  address         String
  phone           String
  email           String
  latitude        Float
  longitude       Float
  timezone        String
  establishedYear Int
  description     String
  logoUrl         String?
  coverImageUrl   String?
  heroImages      Json?
}

model Category {
  id           String        @id
  name         String
  type         String // "income" | "expense"
  icon         String?
  color        String?
  transactions Transaction[]

  // Pengaman terakhir saat dua permintaan menambah kategori bersamaan.
  // Cek aplikasi tetap menangani variasi huruf besar/kecil.
  @@unique([name, type])
}

model Transaction {
  id          String   @id @default(cuid())
  date        String // yyyy-mm-dd (zona masjid)
  type        String // "income" | "expense"
  category    String // label denormalisasi — sesuai kontrak frontend
  categoryId  String
  categoryRef Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount      Int // rupiah, tanpa sen
  description String
  proofUrl    String?
  recordedBy  String
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([type])
  @@index([categoryId])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  imageUrl    String?
  priority    String   @default("normal") // normal (Biasa) | important (Penting, hanya 1)
  publishedAt DateTime @default(now())
  author      String

  @@index([publishedAt])
}

model Activity {
  id          String  @id @default(cuid())
  title       String
  description String
  date        String // yyyy-mm-dd
  time        String
  location    String
  organizer   String
  imageUrl    String?

  @@index([date])
}

model Official {
  id         String @id @default(cuid())
  name       String
  role       String
  systemRole String @default("pengurus") // superadmin | admin | bendahara | pengurus
  phone      String
  email      String @unique
  status     String @default("active") // active | inactive
  joinedDate String // yyyy-mm-dd
  avatar     String?
}

// Catatan: tabel PrayerDay/PrayerTime (jadwal sholat manual) sudah tidak
// dipakai — jadwal kini dihitung sendiri dari koordinat masjid (adhan) di
// server/services/prayer.ts. Modelnya dihapus agar tidak ada skema mati.

// Pengaturan aplikasi (rekening donasi, preferensi tampilan publik).
// Key-value agar penambahan pengaturan tak perlu migrasi baru.
model Config {
  key   String @id
  value String
}
