# Salin menjadi `.env` lalu jalankan:
#   npm run db:migrate
#   npm run db:seed
DATABASE_URL="file:./dev.db"

# ── Opsional (produksi) ──────────────────────────────────────────────────────

# Alamat publik situs, dipakai untuk metadataBase + pratinjau tautan (OG/Twitter).
# Tanpa ini, tautan pratinjau memakai http://localhost:3000.
# NEXT_PUBLIC_SITE_URL="https://masjidku.example.id"

# Token verifikasi Google Search Console (biarkan kosong bila belum ada).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Set "1" HANYA bila aplikasi berada di belakang reverse-proxy tepercaya
# (nginx/Cloudflare). Saat aktif, rate-limit login mempercayai header
# `x-forwarded-for` sehingga pembatasan berlaku per-IP asli pengunjung.
# TRUST_PROXY="1"

# Kata sandi admin pertama kali (sebelum diganti lewat Pengaturan → Keamanan).
# Ganti sebelum instalasi publik agar tidak memakai bawaan "admin123".
# DEFAULT_ADMIN_PASSWORD="ganti-dengan-yang-kuat"
